{
	"name": "n8n-nodes-suprsend",
	"version": "0.1.1",
	"description": "n8n node for SuprSend: trigger notification workflows and manage users, preferences and lists",
	"license": "MIT",
	"homepage": "https://www.suprsend.com",
	"keywords": [
		"n8n-community-node-package",
		"suprsend",
		"notifications"
	],
	"author": {
		"name": "SuprSend",
		"email": "marketing@suprsend.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ADHESHsuryatej/n8n-nodes-suprsend.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SuprSendApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SuprSend/SuprSend.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.6",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
